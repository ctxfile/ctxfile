# Next writes the social cards without an extension; Pages guesses octet-stream
# and link scrapers then ignore the image. Pin the type.
/opengraph-image
  Content-Type: image/png
/blog/*/opengraph-image
  Content-Type: image/png
# Agent-readable setup instructions: serve as text so agents and browsers
# read them instead of downloading a file.
/setup.md
  Content-Type: text/markdown; charset=utf-8
