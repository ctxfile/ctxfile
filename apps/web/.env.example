# Site analytics (optional). Both are read at BUILD time — this is a static
# export, so changing them requires a rebuild, not just a redeploy.
#
# Leave unset and the site loads no analytics script and makes zero
# third-party requests. That is the default and it is a supported state.

# Enables Plausible for this domain. Nothing loads until this is set.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=ctxfile.dev

# Optional. Overrides the script URL so it can be served first-party, past the
# ad-blockers this audience runs. Point it at a path on ctxfile.dev that the
# CDN proxies to https://plausible.io/js/script.outbound-links.js — Next
# rewrites can't do this because the site is `output: "export"`.
# NEXT_PUBLIC_PLAUSIBLE_SRC=/js/p.js
